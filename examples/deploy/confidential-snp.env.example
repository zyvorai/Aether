# Confidential AMD SEV-SNP lab — local validation and optional live cluster checks.
# Copy to a private file: cp examples/deploy/confidential-snp.env.example ~/aether-snp.env
#
# Live placement requires SNP-capable hardware and attestation-capable cluster (see docs/guides/security/CONFIDENTIAL-CLUSTER-E2E.md).

# Enable SNP TEE checks in CLI/API smoke paths
AETHER_TEE_SNP=1

# Optional Ragnarok attestation bridge (sovereign / air-gapped)
# RAGNAROK_URL=https://ragnarok.example.com
# RAGNAROK_OFFLINE_ATTESTATION=1

# Lab workload for dry-run / validate
AETHER_CONFIDENTIAL_SPEC=examples/confidential-snp.yaml

# Live cluster (when kubeconfig + SNP nodes available)
# AETHER_LABS_LIVE=1
# KUBECONFIG=~/.kube/config
