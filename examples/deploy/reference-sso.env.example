# Copy to a private file and source before deploy-remote.sh
# Example: AETHER_DEPLOY_ENV=~/aether-sso.env ./scripts/deploy-reference-sso.sh HOST USER

# Enable embedded mock IdP (OIDC + SAML) for reference cluster SSO testing
AETHER_REFERENCE_MOCK_IDP=1
AETHER_SESSION_SECRET=mock-idp-dev-session-key-32chars

# Optional: override public URL (auto-set from ingress host or NodePort when unset)
# AETHER_PUBLIC_BASE_URL=http://212.8.252.194:30090

# Optional: combine with ingress
# AETHER_EXPOSE=both
# AETHER_INGRESS_HOST=aether.example.com
# AETHER_INGRESS_CLASS=traefik
