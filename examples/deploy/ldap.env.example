# Active Directory / LDAP — copy to a private env file (never commit secrets)
# Example: AETHER_DEPLOY_ENV=~/aether-ldap.env ./scripts/deploy-remote.sh HOST USER

AETHER_LDAP_URL=ldap://dc.example.com:389
AETHER_LDAP_BASE_DN=DC=example,DC=local
AETHER_LDAP_DOMAIN=example.local
AETHER_LDAP_DEFAULT_ROLE=operator
# AETHER_LDAP_BIND_DN=CN=aether-svc,OU=Service Accounts,DC=example,DC=local
# AETHER_LDAP_BIND_PASSWORD=
# AETHER_LDAP_ROLE_MAP=admin=Domain Admins;operator=Developers;viewer=Domain Users
AETHER_SESSION_SECRET=change-me-minimum-32-characters-long
