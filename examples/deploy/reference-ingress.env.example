# Copy to a private file and source before deploy-remote.sh
# Example: AETHER_DEPLOY_ENV=~/aether-ingress.env ./scripts/deploy-reference-ingress.sh HOST USER

# Expose via Ingress (443) and optional NodePort fallback
AETHER_EXPOSE=both
AETHER_INGRESS_HOST=aether.example.com
AETHER_INGRESS_CLASS=traefik

# TLS: create a cert Secret in the namespace or use cert-manager annotations on Ingress
# AETHER_TLS_SECRET=aether-tls
