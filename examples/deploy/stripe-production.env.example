# Copy to a private file and source before deploy-hosted-stripe-prod.sh
# Example: AETHER_DEPLOY_ENV=~/aether-stripe.env ./scripts/deploy-hosted-stripe-prod.sh HOST USER
#
# Use Stripe Dashboard → Developers → API keys (live mode for production).

# Required for checkout + billing portal
AETHER_STRIPE_SECRET_KEY=sk_live_...
AETHER_STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from Stripe Products (live mode)
AETHER_STRIPE_PRICE_TEAM=price_...
AETHER_STRIPE_PRICE_ENTERPRISE=price_...

# Optional: success/cancel URLs for checkout (defaults to ingress host when set)
# AETHER_STRIPE_SUCCESS_URL=https://aether.example.com/hosted?checkout=success
# AETHER_STRIPE_CANCEL_URL=https://aether.example.com/hosted?checkout=cancel

# Hosted SaaS tenant isolation (production)
# AETHER_TENANT_ID=default
