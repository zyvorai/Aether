# Multi-stage build for Aether CLI
FROM rust:1.88-slim as builder

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy manifests
COPY Cargo.toml Cargo.lock build.rs ./

# Copy source
COPY src ./src
COPY web ./web
COPY packaging ./packaging

# Build release binary
RUN cargo build --release

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies + kubectl (used by cluster watch/exec/port-forward
# subprocess sessions in src/api/handlers.rs)
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && KUBECTL_VERSION="$(curl -fsSL https://dl.k8s.io/release/stable.txt)" \
    && curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/$(dpkg --print-architecture)/kubectl" \
    && chmod +x /usr/local/bin/kubectl

# Copy binary from builder
COPY --from=builder /app/target/release/aether /usr/local/bin/aether

# Create state directory
RUN mkdir -p /root/.aether

# Set entrypoint
ENTRYPOINT ["aether"]

# Default command
CMD ["--help"]

# Labels
LABEL org.opencontainers.image.title="Aether"
LABEL org.opencontainers.image.description="Universal Runtime Control Plane"
LABEL org.opencontainers.image.source="https://github.com/ssahani/aether"
LABEL org.opencontainers.image.licenses="MIT OR Apache-2.0"
